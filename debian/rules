#!/usr/bin/make -f
# Build wlanpi-menu-tui with dh-virtualenv: a private virtualenv at /opt/wlanpi-menu-tui.
# User-run from SSH; there is no systemd unit.

export DH_VIRTUALENV_INSTALL_ROOT=/opt
SNAKE=/usr/bin/python3
PACKAGE=$(shell dh_listpackages)
DH_VENV_DIR=debian/$(PACKAGE)$(DH_VIRTUALENV_INSTALL_ROOT)/$(PACKAGE)

%:
	dh $@ --with python-virtualenv

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_install:
override_dh_auto_test:
override_dh_dwz:

override_dh_virtualenv:
	dh_virtualenv \
		--install-suffix "wlanpi-menu-tui" \
		--builtin-venv \
		--python $(SNAKE) \
		--upgrade-pip \
		--preinstall="setuptools>=68" \
		--preinstall="wheel"
	rm -rf $(DH_VENV_DIR)/.cache $(DH_VENV_DIR)/.gitignore
	find $(DH_VENV_DIR)/include -type d -empty -delete
	rm -f $(DH_VENV_DIR)/lib/python3*/site-packages/$(subst -,_,$(PACKAGE))-*.dist-info/direct_url.json
	grep -rlF "$(CURDIR)/$(DH_VENV_DIR)" $(DH_VENV_DIR)/bin $(DH_VENV_DIR)/pyvenv.cfg \
		| xargs -r sed -i "s|$(CURDIR)/$(DH_VENV_DIR)|$(DH_VIRTUALENV_INSTALL_ROOT)/$(PACKAGE)|g"
	$(SNAKE) -m compileall -q -f -j0 -s $(DH_VENV_DIR) -p $(DH_VIRTUALENV_INSTALL_ROOT)/$(PACKAGE) \
		$(DH_VENV_DIR)/lib

override_dh_strip_nondeterminism:
